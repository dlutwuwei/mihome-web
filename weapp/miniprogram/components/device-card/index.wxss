:host {
  display: block;
  width: 100%;
  height: 100%;
}

.device-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%!important;
  height: 100%;
  min-height: 292rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  text-align: left;
  box-shadow: 0 12rpx 30rpx rgba(55, 59, 102, 0.05);
  transition: transform 150ms ease, opacity 150ms ease;
}

.device-card-hover {
  transform: translateY(-4rpx) scale(0.985);
}

.accent-0 { background: #e9ebfb; color: #5260ba; }
.accent-1 { background: #fdebe6; color: #b16653; }
.accent-2 { background: #fff5da; color: #927838; }
.accent-3 { background: #e5f3ee; color: #477e6d; }

.device-offline {
  background: #f0f1f5;
  filter: grayscale(0.4);
  opacity: 0.72;
}

.card-orbit {
  position: absolute;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.035;
  pointer-events: none;
}

.orbit-one {
  right: -72rpx;
  bottom: -84rpx;
  width: 230rpx;
  height: 230rpx;
}

.orbit-two {
  right: 34rpx;
  bottom: -34rpx;
  width: 108rpx;
  height: 108rpx;
  opacity: 0.025;
}

.device-card-top,
.device-card-bottom {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 6rpx 14rpx rgba(55, 59, 102, 0.035);
  font-size: 26rpx;
  font-weight: 700;
}

.device-status {
  display: flex;
  align-items: center;
  font-size: 19rpx;
  opacity: 0.68;
}

.status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #a8abb7;
}

.status-online { background: #55a98d; }

.device-copy {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.device-name {
  display: block;
  overflow: hidden;
  color: #303345;
  font-size: 29rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-room {
  display: block;
  margin-top: 7rpx;
  font-size: 21rpx;
  opacity: 0.62;
}

.device-card-bottom {
  margin-top: auto;
  padding-top: 26rpx;
}

.device-live {
  display: block;
  max-width: 216rpx;
  overflow: hidden;
  color: #36394a;
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  color: currentColor;
  font-size: 27rpx;
  font-weight: 300;
  line-height: 1;
}
