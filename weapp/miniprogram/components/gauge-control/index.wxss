.gauge {
  position: relative;
  width: 470rpx;
  max-width: 100%;
  height: 470rpx;
  margin: 0 auto;
}

.gauge-disabled { opacity: 0.55; }

.gauge-canvas {
  width: 470rpx;
  max-width: 100%;
  height: 470rpx;
}

.gauge-value {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 280rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.gauge-number {
  color: #2d3041;
  font-size: 58rpx;
  font-weight: 650;
  letter-spacing: -2rpx;
  line-height: 1.15;
}

.gauge-label {
  margin-top: 14rpx;
  color: #696f85;
  font-size: 25rpx;
}

.gauge-hint {
  margin-top: 12rpx;
  color: #adb1bf;
  font-size: 20rpx;
}

.gauge-range {
  position: absolute;
  right: 64rpx;
  bottom: 46rpx;
  left: 64rpx;
  display: flex;
  justify-content: space-between;
  color: #b0b4c1;
  font-size: 20rpx;
  pointer-events: none;
}
