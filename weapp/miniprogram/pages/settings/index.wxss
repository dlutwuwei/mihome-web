.connection-hero {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #555daf, #737bd1);
  box-shadow: 0 20rpx 42rpx rgba(79, 86, 172, 0.2);
  color: #ffffff;
}

.connection-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.connection-copy { flex: 1; min-width: 0; }
.connection-title { display: block; font-size: 30rpx; font-weight: 600; }
.connection-subtitle { display: block; margin-top: 8rpx; overflow: hidden; font-size: 21rpx; opacity: 0.68; text-overflow: ellipsis; white-space: nowrap; }
.connection-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(255,255,255,0.35); }
.connection-dot-active { background: #9ee6c9; box-shadow: 0 0 0 10rpx rgba(158,230,201,0.12); }

.settings-card { padding: 32rpx; }
.field-label { display: block; margin-bottom: 16rpx; color: #656b80; font-size: 24rpx; font-weight: 600; }
.field-input { width: 100%; height: 82rpx; padding: 0 24rpx; border-radius: 22rpx; background: #f5f6fa; font-size: 26rpx; }
.field-placeholder { color: #b5b8c4; }
.field-note { display: block; margin: 12rpx 4rpx 0; color: #a0a4b2; font-size: 20rpx; line-height: 1.5; }
.field-divider { height: 1rpx; margin: 30rpx 0; background: #eff0f5; }
.key-input-row { display: flex; align-items: center; }
.key-input { flex: 1; min-width: 0; }
.key-visibility { flex-shrink: 0; margin-left: 14rpx; padding: 20rpx; color: var(--primary); font-size: 23rpx; }
.connect-button { margin-top: 32rpx; }
.settings-error { margin-top: 20rpx; color: #c2654c; font-size: 23rpx; line-height: 1.6; }

.access-card { padding: 8rpx 30rpx 30rpx; }
.access-heading { margin: 24rpx 0 20rpx; }
.scope-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.scope-pill { padding: 12rpx 18rpx; border-radius: 16rpx; background: var(--primary-soft); color: var(--primary); font-size: 20rpx; }
.access-meta { display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #eff0f5; color: #9a9ead; font-size: 21rpx; }
.clear-entry { margin-top: 26rpx; color: #c47b66; font-size: 23rpx; text-align: center; }
.clear-confirm { margin-top: 26rpx; padding: 22rpx; border-radius: 22rpx; background: #fff3ef; }
.clear-confirm-text { display: block; color: #a86653; font-size: 22rpx; }
.clear-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 18rpx; }
.clear-confirm-button { background: var(--coral); color: #fff; }

.permission-grid { display: grid; gap: 16rpx; }
.permission-card { position: relative; padding: 26rpx 28rpx; overflow: hidden; border-radius: 28rpx; }
.permission-read { background: #e7eaff; color: #555eaf; }
.permission-live { background: #e0f1eb; color: #477e6e; }
.permission-control { background: #ffe7de; color: #a9614d; }
.permission-name { display: block; color: #303345; font-size: 27rpx; font-weight: 600; }
.permission-scope { position: absolute; top: 28rpx; right: 26rpx; font-size: 20rpx; opacity: 0.72; }
.permission-copy { display: block; margin-top: 12rpx; font-size: 22rpx; opacity: 0.76; }

.guide-card { padding: 30rpx; }
.guide-title { display: block; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; }
.guide-copy { display: block; color: #8e93a4; font-size: 22rpx; line-height: 1.75; }
.guide-code { margin: 20rpx 0; padding: 20rpx; overflow-x: auto; border-radius: 18rpx; background: #f4f5f9; color: #5d67bb; font-family: monospace; font-size: 20rpx; white-space: nowrap; }
