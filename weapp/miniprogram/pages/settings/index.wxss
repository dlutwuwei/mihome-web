.connection-hero {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #555daf, #737bd1);
  box-shadow: 0 20rpx 42rpx rgba(79, 86, 172, 0.2);
  color: #ffffff;
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.service-card-hover { transform: scale(0.985); opacity: 0.94; }

.service-card-action {
  display: flex;
  align-items: center;
  margin-left: 18rpx;
  font-size: 22rpx;
  opacity: 0.82;
}

.service-card-arrow { margin-left: 6rpx; font-size: 30rpx; line-height: 1; }

.service-note { display: block; margin: 14rpx 4rpx 0; color: #a0a4b2; font-size: 20rpx; }

.connection-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.connection-copy { flex: 1; min-width: 0; }
.connection-title { display: block; font-size: 30rpx; font-weight: 600; }
.connection-subtitle { display: block; margin-top: 8rpx; overflow: hidden; font-size: 21rpx; opacity: 0.68; text-overflow: ellipsis; white-space: nowrap; }
.connection-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(255,255,255,0.35); }
.connection-dot-active { background: #9ee6c9; box-shadow: 0 0 0 10rpx rgba(158,230,201,0.12); }

.field-label { display: block; margin-bottom: 16rpx; color: #656b80; font-size: 24rpx; font-weight: 600; }
.field-input { width: 100%; height: 82rpx; padding: 0 24rpx; border-radius: 22rpx; background: #f5f6fa; font-size: 26rpx; }
.field-placeholder { color: #b5b8c4; }
.field-note { display: block; margin: 12rpx 4rpx 0; color: #a0a4b2; font-size: 20rpx; line-height: 1.5; }
.field-divider { height: 1rpx; margin: 30rpx 0; background: #eff0f5; }
.key-input-row { position: relative; }
.key-input { width: 100%; padding-right: 128rpx; }
.key-visibility {
  position: absolute;
  top: 50%;
  right: 14rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: #eceef5;
  color: var(--primary);
  font-size: 23rpx;
  line-height: 1.2;
  transform: translateY(-50%);
}
.connect-button { width: 100% !important; margin-top: 32rpx; }
.settings-error { margin-top: 20rpx; color: #c2654c; font-size: 23rpx; line-height: 1.6; }

.access-heading { margin: 24rpx 0 20rpx; }
.access-heading-left { display: flex; align-items: center; }
.permission-help {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #eef0f6;
  color: #7a80a0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
.scope-list { display: flex; flex-wrap: wrap; margin: -6rpx; }
.scope-pill { margin: 6rpx; padding: 12rpx 18rpx; border-radius: 16rpx; background: var(--primary-soft); color: var(--primary); font-size: 20rpx; }
.access-meta { display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #eff0f5; color: #9a9ead; font-size: 21rpx; }
.clear-entry { margin-top: 26rpx; color: #c47b66; font-size: 23rpx; text-align: center; }
.clear-confirm { margin-top: 26rpx; padding: 22rpx; border-radius: 22rpx; background: #fff3ef; }
.clear-confirm-text { display: block; color: #a86653; font-size: 22rpx; }
.clear-actions { display: flex; justify-content: flex-end; margin-top: 18rpx; }
.clear-actions .pill + .pill { margin-left: 14rpx; }
.clear-confirm-button { background: var(--coral); color: #fff; }

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(32, 35, 53, 0.42);
  animation: sheet-mask-in 0.2s ease-out;
}

.service-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 41;
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  padding: 18rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 60rpx rgba(46, 50, 74, 0.16);
  transform: translate3d(0, 110%, 0);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0.24, 1);
}

.service-sheet-open { transform: translate3d(0, 0, 0); }

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 8rpx;
  background: #e2e4ed;
}

.sheet-heading { display: flex; align-items: flex-start; }
.sheet-heading-copy { flex: 1; min-width: 0; }
.sheet-title { display: block; color: #2b2e3d; font-size: 34rpx; font-weight: 600; }
.sheet-subtitle { display: block; margin-top: 8rpx; color: #9a9ead; font-size: 21rpx; }
.sheet-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin: -4rpx -6rpx 0 16rpx;
  color: #b0b3c0;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
}

.sheet-scroll { flex: 1; min-height: 0; max-height: 72vh; margin-top: 30rpx; }
.sheet-access { margin-top: 8rpx; }
.sheet-safe { height: 12rpx; }

@keyframes sheet-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.permission-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  background: rgba(32, 35, 53, 0.42);
  animation: sheet-mask-in 0.2s ease-out;
}

.permission-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 51;
  width: 600rpx;
  padding: 30rpx 34rpx 34rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(46, 50, 74, 0.22);
  transform: translate3d(-50%, -50%, 0);
}

.permission-grid { display: flex; flex-direction: column; margin-top: 28rpx; }
.permission-card + .permission-card { margin-top: 16rpx; }
.permission-card { position: relative; padding: 26rpx 28rpx; overflow: hidden; border-radius: 28rpx; }
.permission-read { background: #e7eaff; color: #555eaf; }
.permission-live { background: #e0f1eb; color: #477e6e; }
.permission-control { background: #ffe7de; color: #a9614d; }
.permission-name { display: block; color: #303345; font-size: 27rpx; font-weight: 600; }
.permission-scope { position: absolute; top: 28rpx; right: 26rpx; font-size: 20rpx; opacity: 0.72; }
.permission-copy { display: block; margin-top: 12rpx; font-size: 22rpx; opacity: 0.76; }
