page {
  --ink: #292c3d;
  --muted: #969bad;
  --primary: #626dcc;
  --primary-dark: #4f56ac;
  --primary-soft: #eceefe;
  --coral: #ef896c;
  --mint: #76c8ae;
  --paper: #ffffff;
  --background: #f4f6fb;
  min-height: 100%;
  background: var(--background);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: none;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
}

button::after {
  border: 0;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 30rpx calc(52rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.ambient {
  position: fixed;
  z-index: 0;
  width: 360rpx;
  height: 360rpx;
  border-radius: 46% 54% 62% 38%;
  pointer-events: none;
  opacity: 0.72;
}

.ambient-top {
  top: -220rpx;
  left: -190rpx;
  background: #dfe3ff;
  transform: rotate(24deg);
}

.ambient-bottom {
  right: -230rpx;
  bottom: -180rpx;
  background: #ffe1d7;
  transform: rotate(-18deg);
}

.page-content {
  position: relative;
  z-index: 1;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 32rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.card {
  border: 1rpx solid rgba(79, 86, 172, 0.04);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: 0 18rpx 48rpx rgba(55, 59, 102, 0.08);
}

.section {
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 6rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
}

.section-note {
  color: var(--muted);
  font-size: 22rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #f0f2f8;
  color: #858a9e;
  font-size: 24rpx;
  white-space: nowrap;
  transition: background 160ms ease, color 160ms ease, transform 160ms ease;
}

.pill-active {
  background: var(--primary);
  box-shadow: 0 10rpx 24rpx rgba(98, 109, 204, 0.22);
  color: #ffffff;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 34rpx;
  border-radius: 28rpx;
  background: var(--primary);
  box-shadow: 0 14rpx 30rpx rgba(98, 109, 204, 0.22);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.button-loading,
.button-disabled {
  opacity: 0.55;
}

.button-secondary {
  background: var(--primary-soft);
  box-shadow: none;
  color: var(--primary);
}

.button-coral {
  background: var(--coral);
  box-shadow: 0 14rpx 30rpx rgba(239, 137, 108, 0.2);
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(55, 59, 102, 0.08);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #c4c7d2;
}

.dot-online {
  background: var(--mint);
  box-shadow: 0 0 0 8rpx rgba(118, 200, 174, 0.12);
}

.muted {
  color: var(--muted);
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: #fff0eb;
  color: #b75d45;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: 38rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-copy {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.skeleton {
  border-radius: 30rpx;
  background: linear-gradient(100deg, #eceef5 20%, #f7f8fb 42%, #eceef5 64%);
  background-size: 300% 100%;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  from { background-position: 100% 0; }
  to { background-position: 0 0; }
}
