{
  "name": "mihome-web",
  "private": true,
  "type": "module",
  "bin": {
    "mihome": "./scripts/mihome.mjs"
  },
  "scripts": {
    "mihome": "node scripts/mihome.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/providers/sgcc && cp src/providers/sgcc/protocol.mjs dist/providers/sgcc/protocol.mjs",
    "build:client": "npm run build --prefix client",
    "tunnel": "node scripts/tunnel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
