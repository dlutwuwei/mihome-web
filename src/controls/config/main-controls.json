[
  {
    "id": "xiaomi-main-sensor",
    "vendor": "xiaomi",
    "match": {
      "specType": [
        "*:device:temperature-humidity-sensor:*"
      ]
    },
    "keep": [
      "temperature-humidity-sensor.temperature",
      "temperature-humidity-sensor.relative-humidity",
      "battery.battery-level"
    ],
    "keepActions": []
  },
  {
    "id": "xiaomi-main-air-purifier",
    "vendor": "xiaomi",
    "match": {
      "specType": [
        "*:device:air-purifier:*"
      ]
    },
    "keep": [
      "air-purifier.on",
      "air-purifier.mode",
      "environment.pm2.5-density",
      "filter.filter-life-level"
    ],
    "fields": {
      "filter.filter-life-level": {
        "label": "滤芯寿命"
      }
    },
    "keepActions": []
  },
  {
    "id": "xiaomi-main-humidifier",
    "vendor": "xiaomi",
    "match": {
      "specType": [
        "*:device:humidifier:*"
      ]
    },
    "keep": [
      "humidifier.on",
      "humidifier.fan-level",
      "humidifier.target-humidity",
      "environment.relative-humidity"
    ],
    "fields": {
      "humidifier.target-humidity": {
        "label": "目标湿度"
      }
    },
    "keepActions": []
  },
  {
    "id": "xiaomi-main-air-conditioner",
    "vendor": "xiaomi",
    "match": {
      "specType": [
        "*:device:air-condition-outlet:*",
        "*:device:air-conditioner:*"
      ]
    },
    "keep": [
      "air-conditioner.on",
      "air-conditioner.mode",
      "air-conditioner.target-temperature",
      "fan-control.fan-level",
      "fan-control.vertical-swing"
    ],
    "fields": {
      "air-conditioner.target-temperature": {
        "label": "目标温度"
      },
      "fan-control.vertical-swing": {
        "label": "上下摆风"
      }
    },
    "keepActions": []
  },
  {
    "id": "xiaomi-main-vacuum",
    "vendor": "xiaomi",
    "match": {
      "specType": [
        "*:device:vacuum:*"
      ]
    },
    "keep": [
      "vacuum.status",
      "vacuum.mode",
      "battery.battery-level"
    ],
    "actions": {
      "2.1": {
        "label": "开始清扫"
      },
      "2.2": {
        "label": "停止清扫"
      },
      "3.1": {
        "label": "回充"
      }
    },
    "keepActions": [
      "2.1",
      "2.2",
      "3.1"
    ]
  },
  {
    "id": "xiaomi-main-microwave",
